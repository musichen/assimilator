# ASSIMILATOR environment example
#
# Copy this file to .env for local development.
# Never commit real tokens, keys, private paths, or machine-specific values.

# Optional workspace override. Defaults to ./knowledge-system.
ASSIMILATOR_WORKSPACE=knowledge-system

# Telegram bot token from BotFather. Required only for `pnpm telegram`.
BOT_key=<telegram-bot-token>

# Optional converter/provider keys for media features that need external services.
# Leave unset for local-first usage.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional converter binary overrides.
ASSIMILATOR_MARKITDOWN_BIN=
ASSIMILATOR_YTDLP_BIN=

# LinkedIn browser authentication (optional — enables full post extraction).
# Leave empty for anonymous scraping (may hit paywalls).
# To use: point to a Chrome profile dir with active LinkedIn session.
LINKEDIN_USER_DATA_DIR=

# --- Optional: whisper.cpp (Metal) — scripts/update-whisper.sh ---
# ASSIMILATOR_WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# ASSIMILATOR_WHISPER_MODEL=/opt/homebrew/share/whisper-cpp/models/ggml-base.bin
# ASSIMILATOR_WHISPER_LANG=ru

# --- Optional: yt-dlp PO-token provider — scripts/setup-pot-provider.sh ---
# ASSIMILATOR_YTDLP_BIN=/absolute/path/to/.venv/bin/yt-dlp
# ASSIMILATOR_YOUTUBE_PLAYER_CLIENTS=web,tv,web_embedded,visionos
